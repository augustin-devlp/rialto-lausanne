NEXT_PUBLIC_SUPABASE_URL=https://ymnhfdkyqbhucxdrnyzq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# OBLIGATOIRE : depuis le durcissement RLS, supabaseService() fail-fast si
# absente (plus de fallback anon silencieux).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
BREVO_API_KEY=your_brevo_api_key
NEXT_PUBLIC_RESTAURANT_ID=046d930d-a4cd-4a43-a11a-7f76bfe74b06
# ⚠️ NE PAS METTRE rialto-lausanne.ch ICI. Ce domaine est administré par
# Just Eat (voir docs/BASCULE_DOMAINE.md) : chaque lien d'email de
# confirmation enverrait le client chez la plateforme concurrente.
# Le repli du code est déjà https://rialto-lausanne.vercel.app.
NEXT_PUBLIC_SITE_URL=https://rialto-lausanne.vercel.app
# ⚠️ DOIT VALOIR LA MÊME CHOSE que NEXT_PUBLIC_SITE_URL. Deuxième fabrique
# d'URL (loyaltyConstants.ts -> liens de carte de fidélité /c/<code>).
# N'en poser qu'une seule les ferait DIVERGER le jour du vrai domaine :
# les reçus pointeraient vers le nouveau, les cartes vers l'ancien.
NEXT_PUBLIC_RIALTO_BASE_URL=https://rialto-lausanne.vercel.app
# Code PIN du scanner de tampons au comptoir (page /scan)
# ⚠️ 8 CARACTÈRES ALPHANUMÉRIQUES (décision Augustin, 22.08.2026).
#   Pourquoi : une session de scan valide permet de CRÉDITER DES TAMPONS.
#   À 4 chiffres, c'est 10 000 combinaisons, et le rate-limit ne ferme rien
#   (son Map vit dans une instance de lambda : la limite réelle est
#   « 5 × nombre d'instances » par minute et par IP).
# ⚠️ ÉVITER les caractères ambigus à lire sur une carte plastifiée sous un
#   comptoir mal éclairé : 0/O, 1/l/I, 5/S, 8/B.
# ⚠️ CE PIN EST ÉCRIT SUR LA CARTE PLASTIFIÉE, sous le comptoir, la même que
#   pour la caisse. La session dure 7 jours : l'écran de connexion revient
#   quatre fois plus souvent qu'avant, et c'est la carte qui rend ça
#   acceptable. Si tu changes ce PIN, CHANGE LA CARTE LE MÊME JOUR.
SCAN_PIN=
# Secret HMAC pour signer le cookie de session scan (chaîne aléatoire longue)
SCAN_COOKIE_SECRET=
# Code PIN du dashboard restaurateur (/dashboard) — DISTINCT du PIN scan
DASHBOARD_PIN=
# Secret HMAC du cookie de session dashboard (chaîne aléatoire longue, distincte)
DASHBOARD_COOKIE_SECRET=
# ⚠️ OBLIGATOIRE (21.08.2026) — secret HMAC du JETON D'ACCÈS AUX COMMANDES.
# Sans lui, /confirmation/<numéro> et les routes de commande REFUSENT tout :
# c'est voulu (une garde ne s'inverse jamais), mais le suivi client sera en
# 404 tant qu'il n'est pas posé dans Vercel. Chaîne aléatoire longue.
ORDER_LINK_SECRET=
# Secret PRÉCÉDENT, à ne remplir QUE le jour d'une rotation : les liens déjà
# envoyés continuent d'être acceptés le temps du recouvrement. Vide sinon.
ORDER_LINK_SECRET_PREVIOUS=
# Push notifications (cascade dashboard D5) — la paire VAPID doit MATCHER
# celle des abonnements existants (NEXT_PUBLIC_VAPID_PUBLIC_KEY déjà en Vercel)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:augustin-domenget@stampify.ch
# Email transactionnel Brevo (D6) — domaine DKIM-validé chez Brevo
BREVO_SENDER_EMAIL=noreply@stampify.ch
BREVO_SENDER_NAME=Rialto
# Tracking publicitaire (chantier go-live, Lots B-C) — AUCUN tag ne charge
# sans consentement (bandeau cookies) ni sans ces IDs
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Absent en v1 (import de la conversion GA4 dans Google Ads) — à poser si
# un tag Ads dédié est décidé plus tard
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Gate avis roue (docs/REVIEW_GATE.md) — 'declarative' (défaut, actif) |
# 'api' (Business Profile API, credentials requis) | 'mock' (QA).
# Les DEUX variables portent la même valeur (serveur + UI).
REVIEW_GATE_MODE=
NEXT_PUBLIC_REVIEW_GATE_MODE=
# Credentials Business Profile API (mode 'api' uniquement — service
# account INVITÉ Manager de la fiche ; clé PEM, \n littéraux acceptés)
GBP_SA_CLIENT_EMAIL=
GBP_SA_PRIVATE_KEY=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
# Mode 'mock' uniquement : avis simulés pour la QA du flux
MOCK_REVIEWS_JSON=

# ─── Session client (lot du 22.08.2026) ────────────────────────────────
# ⚠️ CES DEUX SECRETS SONT REQUIS pour que la connexion par e-mail marche.
#   Sans eux, les routes /api/rialto/session/* rendent 500 et l'écran de
#   connexion le dit — jamais de repli silencieux.
# Générer : openssl rand -base64 48   (ou n'importe quelle chaîne longue)
#
# Signe le COOKIE de session (30 jours, httpOnly).
# ⚠️ Le changer DÉCONNECTE TOUT LE MONDE d'un coup. C'est le seul moyen de
#   révoquer une session : le cookie est auto-porteur, il n'y a pas de table.
CLIENT_SESSION_SECRET=
# Signe le LIEN de connexion envoyé par e-mail (15 minutes).
LOGIN_LINK_SECRET=
# Ancien secret du lien, accepté à la vérification pendant une rotation.
# Le laisser vide en temps normal ; le remplir le jour où on tourne
# LOGIN_LINK_SECRET, pour ne couper personne en plein vol.
LOGIN_LINK_SECRET_PREVIOUS=
